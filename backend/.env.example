# CaptoX backend production environment
APP_ENV=production

# Public frontend origin only. Example:
# FRONTEND_ORIGINS=https://captox.example.com
FRONTEND_ORIGINS=https://captox.example.com

# Backend hostnames accepted by TrustedHostMiddleware.
# Example Railway custom/generated domain plus localhost for maintenance.
ALLOWED_HOSTS=captox-api.example.com

# Put SQLite on the persistent volume in production.
# Example Railway volume mount:
DATABASE_PATH=/data/egx_radar.db

# Do not create synthetic demo data in production.
ENABLE_DEMO_SEED=false

# Simple per-process public API protection.
RATE_LIMIT_PER_MINUTE=120

# Optional AI research layer. Keep the real key out of GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_MIN_SCORE=65
